# Jarvis Unified — Environment Template
# Copy to .env. Load it in your shell before running; never commit .env.

# === Execution (only paper is implemented) ===
JARVIS_MODE=paper
PAPER_STARTING_BALANCE=10000

# === Hard risk limits ===
MAX_STAKE_PER_TRADE=5.0
MAX_DAILY_LOSS=10.0
MAX_OPEN_POSITIONS=2
# Safe default: all order submissions blocked until operator explicitly releases it.
KILL_SWITCH=true

# === Local read-only status API ===
STATUS_HOST=127.0.0.1
STATUS_PORT=8787

# === Optional backend-only Supabase control-plane reporting ===
# Disabled by default. When enabled, set JARVIS_DATABASE_URL in the trusted
# worker's secret manager (never in browser config, source control, or chat).
JARVIS_SUPABASE_CONTROL_PLANE_ENABLED=false
# JARVIS_DATABASE_URL=<set in secret manager only>

# === Live signal runner -> Jarvis Cloudflare worker (python -m research.live_signal_runner --cloudflare) ===
# The worker URL is not secret. The collector token must match the worker's JARVIS_COLLECTOR_TOKEN
# secret; keep it in your shell or secret manager only, never in git.
JARVIS_WORKER_URL=
JARVIS_COLLECTOR_TOKEN=

# === Future adapters (not active; never place real credentials here yet) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_ACCOUNT_ID=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# === Optional independent scraper ===
SCRAPER_ENABLED=false
SCRAPER_SCHEDULE=

# === App secret (generate only when a component requires it) ===
JARVIS_SECRET_KEY=
