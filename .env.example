# Jarvis Unified — Environment Template
# Copy to .env and fill with real values. Never commit .env.

# === Mode ===
JARVIS_MODE=paper          # paper | deriv_demo | mt5_demo | live (live requires explicit unlock)

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Deriv ===
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_ACCOUNT_ID=

# === MT5 (if used) ===
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# === Risk (hard limits — cannot be raised by strategies) ===
MAX_STAKE_PER_TRADE=5.0
MAX_DAILY_LOSS=10.0
MAX_OPEN_POSITIONS=2
KILL_SWITCH=true

# === Status API ===
STATUS_HOST=127.0.0.1
STATUS_PORT=8787

# === Scraper (optional independent module) ===
SCRAPER_ENABLED=false
SCRAPER_SCHEDULE=

# === Security ===
# Generate strong values with: openssl rand -hex 32
JARVIS_SECRET_KEY=
